div(class="w-full")
    div(class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(320px,380px)] lg:items-start")
        div(class="space-y-4")
            // 아이디
            div(class="flex flex-col gap-1")
                label(class="text-[13px] font-medium text-zinc-700") 아이디 (username)
                input(type="text",
                    class="w-full rounded-lg border border-zinc-300 px-3 py-2 text-[13px] focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                    [(ngModel)]="form.username",
                    (ngModelChange)="service.render()",
                    [disabled]="mode === 'edit'",
                    placeholder="temp_user_01")

            // 비밀번호
            div(class="flex flex-col gap-1")
                label(class="text-[13px] font-medium text-zinc-700")
                    | 비밀번호
                    span(*ngIf="mode === 'edit'", class="ml-1 text-xs text-zinc-400") (변경 시에만 입력)
                input(type="password",
                    class="w-full rounded-lg border border-zinc-300 px-3 py-2 text-[13px] focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                    [(ngModel)]="form.password",
                    (ngModelChange)="service.render()",
                    placeholder="••••••••")

            // 표시 이름
            div(class="flex flex-col gap-1")
                label(class="text-[13px] font-medium text-zinc-700") 표시 이름
                input(type="text",
                    class="w-full rounded-lg border border-zinc-300 px-3 py-2 text-[13px] focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                    [(ngModel)]="form.display_name",
                    (ngModelChange)="service.render()",
                    placeholder="Temp User 01")

            // 이메일
            div(class="flex flex-col gap-1")
                label(class="text-[13px] font-medium text-zinc-700") 이메일
                input(type="email",
                    class="w-full rounded-lg border border-zinc-300 px-3 py-2 text-[13px] focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                    [(ngModel)]="form.email",
                    (ngModelChange)="service.render()",
                    placeholder="user@example.com")

            // Profile (JSON)
            div(class="flex flex-col gap-1")
                label(class="text-[13px] font-medium text-zinc-700") Profile (JSON)
                textarea(class="min-h-[80px] w-full rounded-lg border border-zinc-300 px-3 py-2 font-mono text-[13px] focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                    [(ngModel)]="form.profile",
                    (ngModelChange)="onEditorChange()",
                    placeholder='{"department":"engineering","groups":["developers"]}')

            // SAML Attributes (JSON)
            div(class="flex flex-col gap-1")
                label(class="text-[13px] font-medium text-zinc-700") SAML Attributes (JSON)
                textarea(class="min-h-[112px] w-full rounded-lg border border-zinc-300 px-3 py-2 font-mono text-[13px] focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                    [(ngModel)]="form.saml_attributes",
                    (ngModelChange)="onEditorChange()",
                    placeholder='{"urn:oid:0.9.2342.19200300.100.1.1":"temp01","urn:oid:0.9.2342.19200300.100.1.3":"temp01@test-idp.local"}')

            // OIDC Claims (JSON)
            div(class="flex flex-col gap-1")
                label(class="text-[13px] font-medium text-zinc-700") OIDC Claims (JSON)
                textarea(class="min-h-[112px] w-full rounded-lg border border-zinc-300 px-3 py-2 font-mono text-[13px] focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                    [(ngModel)]="form.oidc_claims",
                    (ngModelChange)="onEditorChange()",
                    placeholder='{"preferred_username":"temp01","email":"temp01@test-idp.local"}')

            // 안내 문구
            div(*ngIf="mode === 'create'", class="flex items-center gap-2 rounded-lg border border-amber-200 bg-amber-50 p-3")
                svg(class="size-4 shrink-0 text-amber-500", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z")
                span(class="text-xs text-amber-700") 임시 계정은 생성 시점부터 24시간 후 자동으로 만료됩니다.

            // 버튼
            div(class="flex items-center justify-end gap-2 pt-2")
                button(type="button",
                    class="rounded-lg border border-zinc-300 bg-white px-4 py-2 text-[13px] text-zinc-600 transition-colors hover:bg-zinc-50",
                    (click)="cancel()")
                    | 취소
                button(type="button",
                    class="rounded-lg bg-indigo-600 px-4 py-2 text-[13px] text-white transition-colors hover:bg-indigo-700 disabled:opacity-50",
                    [disabled]="saving",
                    (click)="save()")
                    span(*ngIf="!saving")
                        | {{ mode === 'create' ? '생성' : '저장' }}
                    span(*ngIf="saving") 처리 중...

        aside(class="rounded-lg border border-sky-200 bg-sky-50 p-3 lg:sticky lg:top-4")
            div(class="flex items-start justify-between gap-3")
                div(class="min-w-0")
                    p(class="text-xs font-semibold text-sky-800") pysaml2 지원 속성
                    p(class="mt-1 text-xs leading-5 text-sky-700") 기본 임시 계정에는 test-idp 표준 속성이 자동 적용됩니다.
                span(class="shrink-0 rounded-md bg-white px-2 py-1 text-[11px] font-semibold text-sky-700") {{ attributeCatalog.length }}개
            input(type="search",
                class="mt-3 w-full rounded-lg border border-sky-200 bg-white px-3 py-2 text-[13px] text-zinc-800 outline-none transition focus:border-sky-300 focus:ring-2 focus:ring-sky-100",
                [(ngModel)]="attributeFilter",
                (ngModelChange)="service.render()",
                placeholder="속성 검색")
            div(class="mt-3 grid max-h-[560px] gap-2 overflow-y-auto pr-1")
                div(*ngFor="let attr of filteredAttributeCatalog()",
                    class="rounded-lg border border-sky-200 bg-white px-3 py-2")
                    div(class="flex items-start justify-between gap-2")
                        div(class="min-w-0")
                            p(class="break-all text-[13px] font-semibold text-zinc-900") {{ attr.friendly_name || attr.name }}
                            p(class="mt-1 break-all font-mono text-[11px] text-zinc-500") {{ attr.name }}
                        button(type="button",
                            class="shrink-0 rounded-md border border-zinc-200 bg-white px-2 py-1 text-[11px] font-semibold text-zinc-700 transition hover:bg-zinc-50 disabled:opacity-50",
                            [disabled]="addingAttributeKey === attributeKey(attr)",
                            (click)="addCatalogAttribute(attr)")
                            span(*ngIf="addingAttributeKey !== attributeKey(attr)") 추가
                            span(*ngIf="addingAttributeKey === attributeKey(attr)") 추가 중
                    div(class="mt-2 flex flex-wrap items-center gap-1.5")
                        span(*ngIf="attr.has_saml", class="rounded-md bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700") SAML 있음
                        span(*ngIf="!attr.has_saml", class="rounded-md bg-zinc-100 px-2 py-0.5 text-[11px] font-semibold text-zinc-500") SAML 없음
                        span(*ngIf="attr.has_oidc", class="rounded-md bg-indigo-50 px-2 py-0.5 text-[11px] font-semibold text-indigo-700") OIDC 있음
                        span(*ngIf="!attr.has_oidc", class="rounded-md bg-zinc-100 px-2 py-0.5 text-[11px] font-semibold text-zinc-500") OIDC 없음
                        span(class="rounded-md bg-sky-50 px-2 py-0.5 text-[11px] font-medium text-sky-700") {{ attr.source }}
                    p(class="mt-2 break-all text-[11px] text-zinc-600") OIDC: {{ attr.oidc_claim_key }}
                    p(class="mt-1 break-all text-[11px] text-zinc-600") 예시: {{ stringifyValue(attr.example) }}
                div(*ngIf="filteredAttributeCatalog().length === 0", class="rounded-lg border border-sky-200 bg-white px-3 py-6 text-center text-xs text-zinc-500") 검색 결과가 없습니다.
