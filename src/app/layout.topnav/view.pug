div(class="flex h-full min-h-0 flex-col bg-[#f6f7f9]")
    header(class="sticky top-0 z-30 border-b border-zinc-200 bg-white/95 backdrop-blur")
        div(class="mx-auto flex w-full max-w-[1440px] items-center gap-3 px-4 py-2.5 sm:px-6 lg:px-8")
            a(routerLink="/", class="flex min-w-0 items-center gap-2.5")
                div(class="flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-zinc-200 bg-white")
                    img(src="/assets/brand/test-idp-favicon.svg", alt="Test Identity Provider", class="h-6 w-6")
                div(class="hidden min-w-0 sm:block")
                    p(class="truncate text-[14px] font-semibold leading-5 text-zinc-950") Test IdP
                    p(class="truncate text-[11px] leading-4 text-zinc-500") SAML / OIDC test provider

            nav(class="flex flex-1 items-center justify-center gap-1")
                a(routerLink="/", [class]="navClass('/')") 홈
                a(routerLink="/saml/register", [class]="navClass('/saml')") SAML
                a(routerLink="/oidc/register", [class]="navClass('/oidc')") OIDC

            div(*ngIf="service.auth.session?.id", class="flex min-w-0 items-center justify-end gap-2")
                div(class="hidden min-w-0 text-right md:block")
                    span(class="block truncate text-[12px] font-medium text-zinc-900") {{service.auth.session?.name || 'Tester'}}
                    span(class="block truncate text-[10px] text-zinc-400") {{service.auth.session?.role || ''}}
                a(href="/auth/logout", class="inline-flex h-8 items-center gap-1.5 rounded-md border border-zinc-200 bg-white px-2.5 text-xs font-medium text-zinc-600 transition hover:border-zinc-300 hover:bg-zinc-50")
                    svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-3.5")
                        path(stroke-linecap="round", stroke-linejoin="round", d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9")
                    span(class="hidden sm:inline") Logout
            a(*ngIf="!service.auth.session?.id",
                routerLink="/access",
                class="inline-flex h-8 items-center rounded-md bg-zinc-950 px-3 text-xs font-semibold text-white transition hover:bg-zinc-800") Login

    main(class="min-h-0 flex-1 overflow-auto")
        router-outlet

wiz-portal-season-modal
div(*ngIf="service.status.loading", class="fixed inset-0 z-50 flex items-center justify-center bg-zinc-950/20 backdrop-blur-sm")
    wiz-portal-season-loading-season(className="w-10 h-10 text-zinc-900 animate-spin duration-700")
