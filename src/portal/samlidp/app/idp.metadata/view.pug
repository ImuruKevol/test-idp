div(class="space-y-4")
    // Loading
    div(*ngIf="loading", class="flex items-center justify-center py-12")
        span(class="text-[13px] text-zinc-400") 로딩 중...

    div(*ngIf="!loading && idpInfo")
        h2(class="text-lg font-semibold text-zinc-950") IdP 메타데이터 배포

        // Endpoint Summary
        div(class="mt-4 space-y-3")
            div(class="rounded-xl border border-zinc-200 bg-white p-4")
                p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400") Entity ID
                div(class="mt-1 flex items-center gap-2")
                    p(class="flex-1 text-[13px] font-medium text-zinc-900 break-all") {{idpInfo.entity_id}}
                    button(class="shrink-0 rounded-lg px-2.5 py-1 text-xs font-medium text-zinc-500 ring-1 ring-zinc-200 transition hover:bg-zinc-50",
                        (click)="copyToClipboard(idpInfo.entity_id, 'entityId')")
                        span(*ngIf="copied !== 'entityId'") 복사
                        span(*ngIf="copied === 'entityId'", class="text-emerald-600") 복사됨

            div(class="grid gap-3 md:grid-cols-2")
                div(class="rounded-xl border border-zinc-200 bg-white p-4")
                    p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400") SSO Endpoints
                    div(class="mt-2 space-y-2")
                        div(class="flex items-center gap-2")
                            span(class="rounded bg-orange-100 px-2 py-0.5 text-xs font-semibold text-orange-700") POST
                            span(class="text-xs text-zinc-700 break-all") {{idpInfo.sso_post}}
                        div(class="flex items-center gap-2")
                            span(class="rounded bg-orange-100 px-2 py-0.5 text-xs font-semibold text-orange-700") Redirect
                            span(class="text-xs text-zinc-700 break-all") {{idpInfo.sso_redirect}}

                div(class="rounded-xl border border-zinc-200 bg-white p-4")
                    p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400") SLO Endpoints
                    div(class="mt-2 space-y-2")
                        div(class="flex items-center gap-2")
                            span(class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700") POST
                            span(class="text-xs text-zinc-700 break-all") {{idpInfo.slo_post}}
                        div(class="flex items-center gap-2")
                            span(class="rounded bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700") Redirect
                            span(class="text-xs text-zinc-700 break-all") {{idpInfo.slo_redirect}}

            div(class="rounded-xl border border-zinc-200 bg-white p-4")
                p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400") NameID Formats
                div(class="mt-2 flex flex-wrap gap-2")
                    span(*ngFor="let fmt of idpInfo.nameid_formats", class="rounded-full bg-zinc-100 px-2.5 py-1 text-xs text-zinc-600") {{getNameIdShort(fmt)}}

            div(class="rounded-xl border border-zinc-200 bg-white p-4")
                p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400") Sign Algorithm
                p(class="mt-1 text-xs text-zinc-600") {{idpInfo.sign_algorithm}}

            div(class="rounded-xl border border-zinc-200 bg-white p-4")
                p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400") Signing Certificate
                div(class="mt-2 relative")
                    pre(class="max-h-40 overflow-auto rounded-lg bg-zinc-50 p-3 text-[11px] text-zinc-700 font-mono leading-relaxed") {{idpInfo.certificate}}
                    button(class="absolute top-2 right-2 rounded-lg px-2.5 py-1 text-xs font-medium text-zinc-500 ring-1 ring-zinc-200 bg-white transition hover:bg-zinc-50",
                        (click)="copyToClipboard(idpInfo.certificate, 'cert')")
                        span(*ngIf="copied !== 'cert'") 복사
                        span(*ngIf="copied === 'cert'", class="text-emerald-600") 복사됨

        // XML Metadata
        div(class="mt-6")
            div(class="flex items-center justify-between mb-3")
                h3(class="text-[15px] font-semibold text-zinc-950") IdP Metadata XML
                div(class="flex gap-2")
                    button(class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-zinc-600 ring-1 ring-zinc-200 transition hover:bg-zinc-50",
                        (click)="copyToClipboard(metadataXml, 'xml')")
                        span(*ngIf="copied !== 'xml'") XML 복사
                        span(*ngIf="copied === 'xml'", class="text-emerald-600") 복사됨
                    button(class="inline-flex items-center gap-1.5 rounded-lg bg-zinc-900 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-zinc-800",
                        (click)="downloadXml()") 다운로드

            pre(class="max-h-96 overflow-auto rounded-xl border border-zinc-200 bg-zinc-50 p-4 text-[11px] text-zinc-700 font-mono leading-relaxed") {{metadataXml}}

    // Error state
    div(*ngIf="!loading && !idpInfo", class="rounded-2xl border border-dashed border-zinc-300 bg-zinc-50 p-8 text-center")
        p(class="text-[13px] text-zinc-500") IdP 정보를 불러올 수 없습니다.
