div(class="flex min-h-screen items-center justify-center bg-[#f6f7f9] px-4")
    div(class="w-full max-w-sm rounded-lg border border-zinc-200 bg-white")
        div(class="border-b border-zinc-200 px-5 py-4")
            div(class="flex items-center gap-2.5")
                div(class="flex h-8 w-8 items-center justify-center overflow-hidden rounded-lg border border-zinc-200 bg-white")
                    img(src="/assets/brand/test-idp-favicon.svg", alt="Test Identity Provider", class="h-6 w-6")
                div
                    h1(class="text-[16px] font-semibold text-zinc-950") Test IdP
                    p(class="text-xs text-zinc-500") 관리자 로그인

        div(class="space-y-4 px-5 py-5")
            div
                label(class="mb-1 block text-[13px] font-medium text-zinc-700") 사용자명
                input(type="text",
                    [(ngModel)]="data.username",
                    (ngModelChange)="service.render()",
                    (keydown.enter)="login()",
                    placeholder="admin",
                    class="w-full rounded-md border border-zinc-300 px-3 py-2 text-[13px] text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500")
            div
                label(class="mb-1 block text-[13px] font-medium text-zinc-700") 비밀번호
                input(type="password",
                    [(ngModel)]="data.password",
                    (ngModelChange)="service.render()",
                    (keydown.enter)="login()",
                    placeholder="••••••••",
                    class="w-full rounded-md border border-zinc-300 px-3 py-2 text-[13px] text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-500 focus:outline-none focus:ring-1 focus:ring-zinc-500")
            button((click)="login()",
                [disabled]="loggingIn",
                class="h-9 w-full rounded-md bg-zinc-950 px-4 text-[13px] font-semibold text-white transition hover:bg-zinc-800 disabled:opacity-50")
                | {{ loggingIn ? '로그인 중...' : '로그인' }}

