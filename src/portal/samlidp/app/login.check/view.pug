div(class="space-y-4")
    // Loading
    div(*ngIf="loading", class="flex items-center justify-center py-12")
        span(class="text-[13px] text-zinc-400") 로딩 중...

    // === INPUT MODE ===
    div(*ngIf="!loading && mode === 'input'")
        h2(class="text-lg font-semibold text-zinc-950") SSO 디버그

        // Tabs: SP Initiated vs IdP Initiated
        div(class="mt-4 flex gap-4 border-b border-zinc-200 pb-2")
            span(class="text-[13px] font-semibold text-orange-600") SP Initiated SSO
            span(class="text-[13px] text-zinc-400") |
            span(class="text-[13px] text-zinc-500 cursor-pointer hover:text-orange-600",
                (click)="mode = 'idp-init'; service.render()") IdP Initiated SSO

        // SP Initiated: Paste AuthnRequest
        div(class="mt-4 space-y-4")
            div
                label(class="text-[13px] font-medium text-zinc-700") SAMLRequest (Base64)
                textarea([(ngModel)]="samlRequestInput",
                    (ngModelChange)="service.render()",
                    rows="6",
                    placeholder="SP가 보낸 SAMLRequest (Base64 인코딩 값)를 붙여넣기...",
                    class="mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 font-mono text-xs text-zinc-800 placeholder:text-zinc-400 focus:border-orange-400 focus:outline-none focus:ring-1 focus:ring-orange-400")

            div(class="grid gap-4 md:grid-cols-2")
                div
                    label(class="text-[13px] font-medium text-zinc-700") RelayState
                    input([(ngModel)]="relayStateInput",
                        (ngModelChange)="service.render()",
                        placeholder="(선택)",
                        class="mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-800 placeholder:text-zinc-400 focus:border-orange-400 focus:outline-none focus:ring-1 focus:ring-orange-400")

                div
                    label(class="text-[13px] font-medium text-zinc-700") Binding
                    select([(ngModel)]="bindingInput",
                        (ngModelChange)="service.render()",
                        class="mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-800 focus:border-orange-400 focus:outline-none focus:ring-1 focus:ring-orange-400")
                        option(value="POST") HTTP-POST
                        option(value="Redirect") HTTP-Redirect

            div(class="flex justify-end")
                button(class="inline-flex items-center gap-2 rounded-lg bg-orange-500 px-5 py-2.5 text-[13px] font-semibold text-white transition hover:bg-orange-600 disabled:opacity-50",
                    [disabled]="!samlRequestInput.trim()",
                    (click)="parseRequest()") AuthnRequest 파싱

        // Recent Transactions
        div(*ngIf="transactions.length > 0", class="mt-8")
            h3(class="text-[15px] font-semibold text-zinc-950 mb-3") 최근 트랜잭션
            div(class="space-y-2")
                div(*ngFor="let tx of transactions; let i = index",
                    class="rounded-xl border border-zinc-200 bg-white p-3 text-xs")
                    div(class="flex items-center justify-between")
                        div(class="flex items-center gap-2")
                            span(class="rounded-full px-2 py-0.5 text-xs font-semibold",
                                [class]="tx.status === 'success' ? 'bg-emerald-50 text-emerald-700' : tx.status === 'pending' ? 'bg-amber-50 text-amber-700' : 'bg-zinc-100 text-zinc-600'") {{tx.status}}
                            span(class="text-zinc-600 truncate max-w-[200px]") {{tx.sp_entity_id}}
                        span(class="text-zinc-400") {{tx.created}}

    // === IDP INITIATED MODE ===
    div(*ngIf="!loading && mode === 'idp-init'")
        h2(class="text-lg font-semibold text-zinc-950") IdP Initiated SSO

        div(class="mt-4 flex gap-4 border-b border-zinc-200 pb-2")
            span(class="text-[13px] text-zinc-500 cursor-pointer hover:text-orange-600",
                (click)="mode = 'input'; service.render()") SP Initiated SSO
            span(class="text-[13px] text-zinc-400") |
            span(class="text-[13px] font-semibold text-orange-600") IdP Initiated SSO

        div(*ngIf="spList.length === 0", class="mt-6 rounded-2xl border border-dashed border-zinc-300 bg-zinc-50 p-8 text-center")
            p(class="text-[13px] text-zinc-500") 등록된 SP가 없습니다. 먼저 "Register SP" 탭에서 SP를 등록하세요.

        div(*ngIf="spList.length > 0", class="mt-4 space-y-4")
            div
                label(class="text-[13px] font-medium text-zinc-700") 대상 SP 선택
                select([(ngModel)]="selectedSpId",
                    (ngModelChange)="onSpChange()",
                    class="mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-800 focus:border-orange-400 focus:outline-none focus:ring-1 focus:ring-orange-400")
                    option(value="") -- SP 선택 --
                    option(*ngFor="let sp of spList", [value]="sp.id") {{sp.entity_id}}

            div(*ngIf="selectedSpAcs")
                p(class="text-xs text-zinc-500") ACS URL: {{selectedSpAcs}}

            div
                label(class="text-[13px] font-medium text-zinc-700") 테스트 사용자 선택
                select([(ngModel)]="selectedUserId",
                    (ngModelChange)="service.render()",
                    class="mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-800 focus:border-orange-400 focus:outline-none focus:ring-1 focus:ring-orange-400")
                    option(value="") -- 사용자 선택 --
                    option(*ngFor="let u of users", [value]="u.id") {{u.username}} ({{u.display_name}})

            div(class="rounded-xl border border-amber-200 bg-amber-50 p-3")
                p(class="text-xs text-amber-700") 경고: unsolicited response를 SP가 허용하지 않을 수 있습니다.

            div(class="flex justify-end")
                button(class="inline-flex items-center gap-2 rounded-lg bg-orange-500 px-5 py-2.5 text-[13px] font-semibold text-white transition hover:bg-orange-600 disabled:opacity-50",
                    [disabled]="!selectedSpId || !selectedUserId",
                    (click)="startIdpInitiated()") Response 설정으로

    // === RESPOND MODE ===
    div(*ngIf="!loading && mode === 'respond' && parsedRequest")
        div(class="flex items-center gap-3 mb-4")
            button(class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-100 hover:text-zinc-600",
                (click)="showInput()")
                svg(class="size-4", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18")
            h2(class="text-lg font-semibold text-zinc-950") SAMLResponse 설정

        // Parsed Request Summary
        div(*ngIf="parsedRequest.request_id", class="rounded-xl border border-zinc-200 bg-zinc-50 p-4 mb-4")
            p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-2") AuthnRequest 요약
            div(class="grid gap-2 text-xs")
                div(class="flex gap-2")
                    span(class="font-medium text-zinc-600 w-32") Request ID
                    span(class="text-zinc-800 break-all") {{parsedRequest.request_id}}
                div(class="flex gap-2")
                    span(class="font-medium text-zinc-600 w-32") Issuer (SP)
                    span(class="text-zinc-800 break-all") {{parsedRequest.issuer}}
                div(class="flex gap-2")
                    span(class="font-medium text-zinc-600 w-32") ACS URL
                    span(class="text-zinc-800 break-all") {{parsedRequest.acs_url}}
                div(*ngIf="parsedRequest.relay_state", class="flex gap-2")
                    span(class="font-medium text-zinc-600 w-32") RelayState
                    span(class="text-zinc-800") {{parsedRequest.relay_state}}
                div(*ngIf="parsedRequest.nameid_format", class="flex gap-2")
                    span(class="font-medium text-zinc-600 w-32") NameID Format
                    span(class="text-zinc-800") {{parsedRequest.nameid_format}}
                div(class="flex gap-2")
                    span(class="font-medium text-zinc-600 w-32") ForceAuthn
                    span(class="text-zinc-800") {{parsedRequest.force_authn}}
                div(class="flex gap-2")
                    span(class="font-medium text-zinc-600 w-32") IsPassive
                    span(class="text-zinc-800") {{parsedRequest.is_passive}}

        // Response Settings
        div(class="space-y-4")
            div
                label(class="text-[13px] font-medium text-zinc-700") 테스트 사용자
                select([(ngModel)]="selectedUserId",
                    (ngModelChange)="service.render()",
                    class="mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-800 focus:border-orange-400 focus:outline-none focus:ring-1 focus:ring-orange-400")
                    option(value="") -- 사용자 선택 --
                    option(*ngFor="let u of users", [value]="u.id") {{u.username}} ({{u.display_name}})

            div
                label(class="text-[13px] font-medium text-zinc-700") Attribute Preset (SAML)
                select([(ngModel)]="selectedPresetId",
                    (ngModelChange)="service.render()",
                    class="mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-800 focus:border-orange-400 focus:outline-none focus:ring-1 focus:ring-orange-400")
                    option(value="") -- 없음 (사용자 기본 속성만) --
                    option(*ngFor="let p of presets", [value]="p.id") {{p.name}}

            div(class="grid gap-4 md:grid-cols-2")
                div
                    label(class="text-[13px] font-medium text-zinc-700") NameID Format
                    select([(ngModel)]="nameidFormat",
                        (ngModelChange)="service.render()",
                        class="mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-800 focus:border-orange-400 focus:outline-none focus:ring-1 focus:ring-orange-400")
                        option(value="urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress") emailAddress
                        option(value="urn:oasis:names:tc:SAML:2.0:nameid-format:persistent") persistent
                        option(value="urn:oasis:names:tc:SAML:2.0:nameid-format:transient") transient
                        option(value="urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified") unspecified

                div
                    label(class="text-[13px] font-medium text-zinc-700") NameID Value (빈칸=자동)
                    input([(ngModel)]="nameidValue",
                        (ngModelChange)="service.render()",
                        placeholder="자동 생성",
                        class="mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-[13px] text-zinc-800 placeholder:text-zinc-400 focus:border-orange-400 focus:outline-none focus:ring-1 focus:ring-orange-400")

            div(class="flex flex-wrap gap-6")
                label(class="flex items-center gap-2 text-[13px] text-zinc-700 cursor-pointer")
                    input(type="checkbox", [(ngModel)]="signResponse", (ngModelChange)="service.render()", class="rounded border-zinc-300 text-orange-500 focus:ring-orange-400")
                    | Response 서명
                label(class="flex items-center gap-2 text-[13px] text-zinc-700 cursor-pointer")
                    input(type="checkbox", [(ngModel)]="signAssertion", (ngModelChange)="service.render()", class="rounded border-zinc-300 text-orange-500 focus:ring-orange-400")
                    | Assertion 서명

            div
                label(class="text-[13px] font-medium text-zinc-700") Attribute Override (JSON, 선택)
                textarea([(ngModel)]="attributeOverrides",
                    (ngModelChange)="service.render()",
                    rows="3",
                    placeholder='{"urn:oid:0.9.2342.19200300.100.1.3": "override@test-idp.local"}',
                    class="mt-1 w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 font-mono text-xs text-zinc-800 placeholder:text-zinc-400 focus:border-orange-400 focus:outline-none focus:ring-1 focus:ring-orange-400")
                div(class="mt-2 rounded-xl border border-orange-200 bg-orange-50 p-3")
                    p(class="text-xs font-semibold text-orange-800") OID 속성 선택
                    p(class="mt-1 text-xs text-orange-700") friendly name이나 임의 키를 넣어도 응답 생성 시 OID URN으로 정규화됩니다. 아래 목록을 누르면 자주 쓰는 속성을 바로 추가할 수 있습니다.
                    div(class="mt-3 grid gap-2 md:grid-cols-2")
                        button(*ngFor="let attr of samlAttributeCatalog",
                            type="button",
                            class="rounded-lg border border-orange-200 bg-white px-3 py-2 text-left transition hover:border-orange-300 hover:bg-orange-50",
                            (click)="insertAttributeOverride(attr)")
                            div(class="flex items-center justify-between gap-2")
                                span(class="text-[13px] font-semibold text-zinc-900") {{ attr.friendly_name || attr.urn }}
                                span(*ngIf="attr.custom", class="rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-semibold text-amber-700") CUSTOM
                            p(class="mt-1 text-[11px] font-mono text-zinc-500 break-all") {{ attr.urn }}
                            p(class="mt-1 text-[11px] text-zinc-600 break-all") 예시: {{ stringifyValue(attr.example) }}

            div(class="flex justify-end")
                button(class="inline-flex items-center gap-2 rounded-lg bg-orange-500 px-5 py-2.5 text-[13px] font-semibold text-white transition hover:bg-orange-600 disabled:opacity-50",
                    [disabled]="!selectedUserId",
                    (click)="buildResponse()") SAMLResponse 생성

    // === RESULT MODE ===
    div(*ngIf="!loading && mode === 'result' && responseResult")
        div(class="flex items-center gap-3 mb-4")
            button(class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-100 hover:text-zinc-600",
                (click)="showInput()")
                svg(class="size-4", xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="2", stroke="currentColor")
                    path(stroke-linecap="round", stroke-linejoin="round", d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18")
            h2(class="text-lg font-semibold text-zinc-950") SAMLResponse 결과

        div(class="space-y-4")
            // Summary
            div(class="grid gap-3 md:grid-cols-2")
                div(class="rounded-xl border border-zinc-200 bg-white p-4")
                    p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400") Response ID
                    p(class="mt-1 text-xs text-zinc-800 break-all") {{responseResult.response_id}}
                div(class="rounded-xl border border-zinc-200 bg-white p-4")
                    p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400") Assertion ID
                    p(class="mt-1 text-xs text-zinc-800 break-all") {{responseResult.assertion_id}}
                div(class="rounded-xl border border-zinc-200 bg-white p-4")
                    p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400") NameID
                    p(class="mt-1 text-xs text-zinc-800") {{responseResult.nameid_value}}
                div(class="rounded-xl border border-zinc-200 bg-white p-4")
                    p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400") Session Index
                    p(class="mt-1 text-xs text-zinc-800") {{responseResult.session_index}}

            div(class="flex flex-wrap gap-2")
                span(class="rounded-full px-2.5 py-1 text-xs font-medium",
                    [class]="responseResult.signed_response ? 'bg-emerald-50 text-emerald-700' : 'bg-zinc-100 text-zinc-500'") Response {{responseResult.signed_response ? 'Signed' : 'Unsigned'}}
                span(class="rounded-full px-2.5 py-1 text-xs font-medium",
                    [class]="responseResult.signed_assertion ? 'bg-emerald-50 text-emerald-700' : 'bg-zinc-100 text-zinc-500'") Assertion {{responseResult.signed_assertion ? 'Signed' : 'Unsigned'}}

            // Attributes
            div(*ngIf="responseResult.attributes", class="rounded-xl border border-zinc-200 bg-white p-4")
                p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-2") Attributes
                div(class="space-y-1")
                    div(*ngFor="let key of objectKeys(responseResult.attributes)", class="flex gap-2 text-xs")
                        span(class="font-medium text-zinc-600 min-w-[120px]") {{key}}
                        span(class="text-zinc-800 break-all") {{stringify(responseResult.attributes[key])}}

            // ACS URL & RelayState
            div(class="rounded-xl border border-zinc-200 bg-white p-4")
                p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-2") POST Target
                p(class="text-xs text-zinc-800 break-all") {{responseResult.acs_url}}
                p(*ngIf="responseResult.relay_state", class="mt-1 text-xs text-zinc-500") RelayState: {{responseResult.relay_state}}

            // Raw XML
            div
                div(class="flex items-center justify-between mb-2")
                    p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400") SAMLResponse XML
                    button(class="rounded-lg px-2.5 py-1 text-xs font-medium text-zinc-500 ring-1 ring-zinc-200 transition hover:bg-zinc-50",
                        (click)="copyText(responseResult.response_xml)") 복사
                pre(class="max-h-64 overflow-auto rounded-xl border border-zinc-200 bg-zinc-50 p-3 text-[11px] text-zinc-700 font-mono leading-relaxed") {{responseResult.response_xml}}

            // Base64
            div
                div(class="flex items-center justify-between mb-2")
                    p(class="text-xs font-semibold uppercase tracking-wider text-zinc-400") SAMLResponse (Base64)
                    button(class="rounded-lg px-2.5 py-1 text-xs font-medium text-zinc-500 ring-1 ring-zinc-200 transition hover:bg-zinc-50",
                        (click)="copyText(responseResult.response_b64)") 복사
                pre(class="max-h-32 overflow-auto rounded-xl border border-zinc-200 bg-zinc-50 p-3 text-[11px] text-zinc-700 font-mono leading-relaxed break-all") {{responseResult.response_b64}}
