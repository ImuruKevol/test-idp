section(class="mx-auto w-full max-w-[1440px] px-5 py-6 sm:px-7 lg:px-10 lg:py-9")
    header(class="mb-6 rounded-2xl border border-slate-200 bg-white px-6 py-6 shadow-sm sm:px-7")
        div(class="flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between")
            div(class="flex min-w-0 items-start gap-4")
                div(class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-orange-500 text-[15px] font-bold text-white shadow-sm") SAML
                div(class="min-w-0")
                    div(class="flex flex-wrap items-center gap-2")
                        h1(class="text-xl font-bold tracking-tight text-slate-950 sm:text-2xl") SAML 테스트
                        span(class="rounded-full bg-orange-50 px-2.5 py-1 text-xs font-semibold text-orange-700") Identity Provider
                    p(class="mt-1 max-w-3xl text-sm leading-6 text-slate-600") SP 메타데이터를 등록하고 IdP 정보를 연결한 뒤 SSO와 SLO를 순서대로 확인합니다.
            div(class="flex flex-wrap items-center gap-2 text-sm")
                span(class="text-slate-500") 현재 화면
                strong(class="rounded-lg bg-slate-950 px-3 py-1.5 font-semibold text-white") {{ tabTitle() }}

    div(class="grid min-w-0 gap-6 lg:grid-cols-[15.5rem_minmax(0,1fr)]")
        aside(class="min-w-0")
            nav(class="grid grid-cols-2 gap-2 sm:grid-cols-4 lg:sticky lg:top-[4.75rem] lg:grid-cols-1", aria-label="SAML 작업 메뉴")
                a(routerLink="/saml/register", [class]="tabClass('register')")
                    span([class]="stepClass('register')") 1
                    span(class="min-w-0")
                        strong(class="block text-sm font-semibold") SP 관리
                        small(class="mt-0.5 hidden text-xs leading-5 sm:block") Metadata 등록·상태 확인
                a(routerLink="/saml/publish", [class]="tabClass('publish')")
                    span([class]="stepClass('publish')") 2
                    span(class="min-w-0")
                        strong(class="block text-sm font-semibold") IdP 정보
                        small(class="mt-0.5 hidden text-xs leading-5 sm:block") Metadata·실행 설정
                a(routerLink="/saml/logincheck", [class]="tabClass('logincheck')")
                    span([class]="stepClass('logincheck')") 3
                    span(class="min-w-0")
                        strong(class="block text-sm font-semibold") 로그인 확인
                        small(class="mt-0.5 hidden text-xs leading-5 sm:block") AuthnRequest·Response
                a(routerLink="/saml/logoutcheck", [class]="tabClass('logoutcheck')")
                    span([class]="stepClass('logoutcheck')") 4
                    span(class="min-w-0")
                        strong(class="block text-sm font-semibold") 로그아웃 확인
                        small(class="mt-0.5 hidden text-xs leading-5 sm:block") SLO·session 정리

            div(class="mt-3 hidden rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-600 lg:block")
                strong(class="block font-semibold text-slate-900") 권장 순서
                p(class="mt-1") 처음이라면 1번부터 진행하세요. 실행 설정은 특정 시험에서 응답을 바꿀 때만 사용합니다.

        main(class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7 lg:p-8")
            div(*ngIf="isTab('register')")
                wiz-portal-samlidp-sp-register
            div(*ngIf="isTab('publish')")
                wiz-portal-samlidp-idp-metadata
            div(*ngIf="isTab('logincheck')")
                wiz-portal-samlidp-login-check
            div(*ngIf="isTab('logoutcheck')")
                wiz-portal-samlidp-logout-check
